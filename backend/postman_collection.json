		{
			"name": "QR Tokens",
			"item": [
				{
					"name": "Issue QR Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"qr_token\", jsonData.data.token);",
									"    pm.collectionVariables.set(\"qr_token_id\", jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"expires_at\": \"2025-12-31 23:59:59\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/qr/rooms/:roomId/tokens",
							"host": ["{{base_url}}"],
							"path": ["qr", "rooms", ":roomId", "tokens"],
							"variable": [
								{
									"key": "roomId",
									"value": ""
								}
							]
						}
					}
				},
				{
					"name": "Resolve QR Token",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/qr/resolve/:token",
							"host": ["{{base_url}}"],
							"path": ["qr", "resolve", ":token"],
							"variable": [
								{
									"key": "token",
									"value": "{{qr_token}}",
									"description": "Plain token from issue endpoint"
								}
							]
						},
						"description": "Public endpoint - No authentication required"
					}
				},
				{
					"name": "List Room Tokens",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/qr/rooms/:roomId/tokens",
							"host": ["{{base_url}}"],
							"path": ["qr", "rooms", ":roomId", "tokens"],
							"variable": [
								{
									"key": "roomId",
									"value": ""
								}
							]
						}
					}
				},
				{
					"name": "Revoke QR Token",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/qr/tokens/:id/revoke",
							"host": ["{{base_url}}"],
							"path": ["qr", "tokens", ":id", "revoke"],
							"variable": [
								{
									"key": "id",
									"value": "{{qr_token_id}}"
								}
							]
						}
					}
				}
			]
		},
